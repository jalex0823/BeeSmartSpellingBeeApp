{
  "name": "BeeSmart Spelling App",
  "short_name": "BeeSmart",
  "description": "Spelling practice with friendly avatars and quizzes.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
