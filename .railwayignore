# Railway ignore file - exclude dev/test files and oversized assets for deploy

# Existing basic ignores
Dockerfile
Dockerfile.*
test_*.py
debug_*.py
*_test.py
comprehensive_test.py
minimal_test.py
quick_test.py
demo_test.py
session_test.py
full_app_test.py
simple_test_app.py
simple_upload_test.py
railway_diagnostic.py
push_to_github.*
commit_changes.sh
__pycache__/
*.pyc
*.pyo
.git/
.vscode/
.env
*.log

# Node/Python/build caches
node_modules/
.venv/
venv/
dist/
build/

# Large design/source files
*.psd
*.blend
*.fbx
*.zip
*.rar

# Legacy / development 3D assets not needed at runtime
3DFiles/
static/3DFiles/
static/models/
Badges/

# Exclude all avatar subfolders except GLB-only folder
static/assets/avatars/*
!static/assets/avatars/glb_files
!static/assets/avatars/glb_files/**
# Exclude known backups
static/assets/avatars/glb_files_backup/

# Temporarily exclude heavy GLB payloads; keep thumbnails only
static/assets/avatars/glb_files/*.glb
!static/assets/avatars/glb_files/AvatarThumbnails/**

# Badge GLBs are not required for runtime (PNG images are used)
static/assets/badges/glb_files/

# Ephemeral local data
data/wordbanks/
 
# Additional ignores to minimize Railway upload size
# Exclude thumbnails, previews, and renders (served from DB or generated)
static/assets/avatars/glb_files/AvatarThumbnails/**
static/assets/avatars/thumbnails/**
static/assets/avatars/**/thumbnails/**
static/assets/avatars/**/previews/**
static/assets/avatars/**/renders/**

