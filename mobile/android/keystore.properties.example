# Android release signing configuration (example)
#
# Copy to: mobile/android/keystore.properties
# Do NOT commit the real keystore.properties file.
#
# storeFile can be relative to the android/ folder.
# Typical setup (recommended): upload-keystore.jks next to this file.

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=upload-keystore.jks
